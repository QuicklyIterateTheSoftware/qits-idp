<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-idp</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The issuer domain: the persisted signing keys, the static client registry read from config,
         and the minting of a token. A plain library jar: entity, persistence, control — NO
         web/JAX-RS (that is `service`).

         It owns its OWN named datasource + persistence unit + Flyway lineage — a separate
         file-based H2 under ~/.qits/data/idp (see
         src/main/resources/META-INF/microprofile-config.properties). Signing keys live there and
         nowhere else, which is the whole reason validation survives a restart.

         The directory is `idp/` (the ci/cd/service shape of the sibling repos) while the artifactId
         is `qits-idp-domain`: this module is the domain layer of the qits-idp repo, and
         `eu.wohlben.qits:qits-idp-idp` would be nonsense. -->
    <artifactId>qits-idp-domain</artifactId>
    <name>qits-idp :: domain</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- The token minting itself: Jwt.claims()...sign(privateKey). This is the only reason
                 the domain module knows anything about JWT at all. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-jwt-build</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- The consuming Quarkus app needs an index of this jar's beans and entities. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
